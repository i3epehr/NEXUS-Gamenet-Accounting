@echo off
chcp 65001 > nul
echo ====================================================
echo     NEXUS GameNet - دریافت و نصب خودکار آپدیت جدید
echo ====================================================

:: ۱. ساخت پوشه پشتیبان و بک‌آپ اضطراری از داده‌ها
if not exist "backups" mkdir backups
if exist "data\nexus_db.json" (
    echo [1/4] پشتیبان‌گیری از دیتابیس فعلی...
    copy /Y "data\nexus_db.json" "backups\nexus_db_%date:~10,4%%date:~4,2%%date:~7,2%_%time:~0,2%%time:~3,2%%time:~6,2%.bak" > nul
    echo دیتابیس فعلی با موفقیت در پوشه backups ذخیره شد.
)

:: ۲. دریافت آخرین تغییرات از گیت‌هاب
echo.
echo [2/4] دریافت تغییرات جدید از گیت‌هاب...
git pull origin main
if %ERRORLEVEL% neq 0 (
    echo خطا در دریافت آپدیت از گیت‌هاب! اتصال اینترنت یا تغییرات گیت را بررسی کنید.
    pause
    exit /b %ERRORLEVEL%
)

:: ۳. نصب پکیج‌های جدید در صورت وجود
echo.
echo [3/4] بررسی و نصب وابستگی‌ها...
call npm install --no-audit

:: ۴. بیلد مجدد برنامه
echo.
echo [4/4] بیلد برنامه...
call npm run build

echo.
echo ====================================================
echo    آپدیت با موفقیت نصب شد و دیتابیس کاملاً حفظ گردید!
echo    اکنون می‌توانید سرور را راه‌اندازی کنید.
echo ====================================================
pause
